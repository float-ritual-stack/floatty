# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.next
*.local

# Turborepo local cache (monorepo scaffold added 2026-04-11)
.turbo/
**/.turbo/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust build artifacts (plugins)
apps/floatty/src-tauri/plugins/*/target/
apps/floatty/src-tauri/plugins/*/Cargo.lock

# Sidecar binaries (built at release time, platform-specific)
apps/floatty/src-tauri/binaries/

# Session exports (conversation artifacts)
.exports/

# Claude Code local config (hooks and settings are personal)
.claude/hooks/
.claude/settings.json
.claude/settings.local.json
# Worktrees created by the Agent tool's isolation: "worktree" mode + manual
# `git worktree add` flows. Per-developer ephemeral checkouts; never committed.
.claude/worktrees/

# pi extension content — per-developer local extension installs
.pi/extensions/

# ink-chat local devtools state (per-developer)
apps/ink-chat/.devtools/

# Door build artifacts — produced by `pnpm --filter <door>-door build`,
# regenerated on every release; never the source of truth.
apps/floatty/doors/*.zip

# Float loop work tracks (survives branch changes, local to developer)
.float/

# btca cache (cloned repos for context queries)
.btca/
btca.config.jsonc
.todos/
.sidecar/
.sidecar-agent
.sidecar-task
.sidecar-pr
.sidecar-start.sh
.sidecar-base
.td-root
